root = true
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
[*.md]
trim_trailing_whitespace = false
[*.{yml,yaml}]
indent_style = space
indent_size = 2
[*.json]
indent_style = space
indent_size = 2
[*.js]
indent_style = space
indent_size = 2
max_line_length = 100
[*.css]
indent_style = space
indent_size = 2
[*.html]
indent_style = space
indent_size = 2
[*.rb]
indent_style = space
indent_size = 2
[*.{sh,bash}]
indent_style = space
indent_size = 2
[Makefile]
indent_style = tab
